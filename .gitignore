# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ─── Backend (NestJS) ────────────────────────────────────────────────────────

# Backend dependencies
Backend/node_modules/

# Backend compiled output
Backend/dist/

# Backend environment variables (keep .env.example)
Backend/.env
Backend/.env.local
Backend/.env.production

# Backend TypeScript incremental build info
Backend/tsconfig.tsbuildinfo

# Backend logs
Backend/*.log
Backend/logs/

# Backend test coverage
Backend/coverage/

# ─── Frontend (Next.js) ──────────────────────────────────────────────────────

# Frontend dependencies
frontend/node_modules/

# Frontend Next.js build output
frontend/.next/
frontend/out/

# Frontend environment variables (keep .env.example if any)
frontend/.env
frontend/.env.local
frontend/.env.production

# Frontend TypeScript incremental build info
frontend/tsconfig.tsbuildinfo

# ─── OS / Editor ─────────────────────────────────────────────────────────────
Thumbs.db
.vscode/settings.json
.idea/
